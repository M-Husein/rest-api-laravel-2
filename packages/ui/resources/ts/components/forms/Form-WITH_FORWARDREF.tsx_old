import { forwardRef } from 'react';

export const Form = forwardRef(
  (
    {
      fieldsetClass,
      disabled,
      inert,
      children,
      ...etc
    }: any,
    ref
  ) => {
    return (
      <form
        {...etc}
        ref={ref}
        inert={inert ?? disabled}
      >
        <fieldset
          className={fieldsetClass}
          disabled={disabled}
        >
          {children}
        </fieldset>
      </form>
    );
  }
);
