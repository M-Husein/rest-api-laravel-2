{
  "name": "programmeria/laravel-locale-switcher",
  "version": "0.1.0",
  "description": "Optional multi-locale switcher (middleware, user preference endpoint, migration) for the starterkit.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5.12",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Programmeria\\LocaleSwitcher\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Programmeria\\LocaleSwitcher\\LocaleSwitcherServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
