<?php
namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Models\PageTranslation;
use Illuminate\Http\Request;
use Illuminate\Validation\Rule;
use Illuminate\Database\QueryException;

class PageTranslationController extends Controller{
  /**
   * Display a listing of page translations.
   */
  public function index(Request $request){
    $query = PageTranslation::query();

    // Optional filters
    if($request->has('name')){
      $query->where('name', $request->name);
    }
    if($request->has('lang')){
      $query->where('lang', $request->lang);
    }

    $translations = $query->paginate($request->query('perPage', 10));
    return jsonSuccess($translations);
  }

  /**
   * Store a newly created page translation.
   */
  public function store(Request $request){
    $validated = $request->validate([
      'name' => 'required|string|max:50',
      'lang' => 'required|string|size:2',
      'text' => 'required|array'
      // 'is_system' => 'sometimes|boolean'
    ]);

    // Check for duplicate name+lang
    $exists = PageTranslation::query()
      ->where('name', $validated['name'])
      ->where('lang', $validated['lang'])
      ->exists();

    if($exists){
      // "Translation for page name '{$validated['name']}' and language '{$validated['lang']}' already exists."
      return jsonError(__('Duplicate', ['name' => 'name & lang']), 409);
    }

    try {
      $translation = PageTranslation::create($validated);
      return jsonSuccess($translation); // , 'Page translation created successfully', 201
    } catch (QueryException $e){
      // Get the underlying PDOException to access errorInfo
      /** @var \Throwable $e */ // This helps static analysis
      $pdoException = $e->getPrevious();
      // MySQL duplicate entry error code is 1062
      if($pdoException && $pdoException->errorInfo[1] == 1062){
        // 'Duplicate entry: name + lang already exists.' (database constraint)
        return jsonError(__('Duplicate', ['name' => 'name & lang']), 409);
      }
      throw $e;
    }
  }

  /**
   * Display the specified page translation.
   */
  public function show(int $id){
    $translation = PageTranslation::query()->find($id);
    if(!$translation){
      // 'Page translation not found'
      return jsonError(__('http-statuses.404'), 404);
    }
    return jsonSuccess($translation);
  }

  /**
   * Update the specified page translation.
   */
  public function update(Request $request, int $id){
    $translation = PageTranslation::query()->find($id);

    if(!$translation){
      // 'Page translation not found'
      return jsonError(__('http-statuses.404'), 404);
    }

    $validated = $request->validate([
      'name' => [
        'sometimes',
        'required',
        'string',
        'max:50',
        Rule::unique('page_translations', 'name')->where(function($query) use ($request, $id, $translation){
          return $query->where('lang', $request->input('lang', $translation->lang))
                        ->where('id', '<>', $id);
        }),
      ],
      'lang' => [
        'sometimes',
        'required',
        'string',
        'size:2',
        Rule::unique('page_translations', 'lang')->where(function($query) use ($request, $id, $translation){
          return $query->where('name', $request->input('name', $translation->name))
                        ->where('id', '<>', $id);
        }),
      ],
      'text' => 'sometimes|required|array'
      // 'is_system' => 'sometimes|boolean'
    ]);

    // Additional manual duplicate check if page name or lang changed
    $newPage = $validated['name'] ?? $translation->name;
    $newLang = $validated['lang'] ?? $translation->lang;

    if($newPage !== $translation->name || $newLang !== $translation->lang){
      $exists = PageTranslation::query()->where('name', $newPage)
        ->where('lang', $newLang)
        ->where('id', '<>', $id)
        ->exists();

      if($exists){
        // "Another translation with page '{$newPage}' and language '{$newLang}' already exists."
        return jsonError(__('Duplicate', ['name' => 'name & lang']), 409);
      }
    }

    try {
      $translation->update($validated);
      return jsonSuccess($translation); // , 'Page translation updated successfully'
    } catch (QueryException $e){
      /** @var \Throwable $e */ // This helps static analysis
      $pdoException = $e->getPrevious();
      if($pdoException && $pdoException->errorInfo[1] == 1062){
        // 'Duplicate entry: name + lang already exists.'
        return jsonError(__('Duplicate', ['name' => 'name & lang']), 409);
      }
      throw $e;
    }
  }

  /**
   * Remove the specified page translation.
   */
  public function destroy(int $id){
    // $translation = PageTranslation::query()->find($id);
    // if(!$translation){
    //   return jsonError(__('http-statuses.404'), 404);
    // }

    // Prevent deletion of system translations (optional but recommended)
    // if($translation->is_system){
    //   return jsonError('System page translations cannot be deleted', 403);
    // }

    $deleted = PageTranslation::destroy($id);
    if(!$deleted){
      return jsonError(__('http-statuses.404'), 404);
    }
    return jsonSuccess();
  }

  /**
   * Get translations for a specific page name and language (frontend endpoint).
   * This is separate from CRUD and doesn't require authentication.
   * Route: /locales/{lang}/page/{name}
   */
  public function getByPageLang(string $lang, string $name){
    $translation = PageTranslation::query()
      ->where('name', $name)
      ->where('lang', $lang)
      ->first();

    if(!$translation){
      // 'Translations not found for this page name and language'
      return jsonError(__('http-statuses.404'), 404);
    }

    return jsonSuccess($translation->text);
  }
}