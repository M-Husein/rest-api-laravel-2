<?php
use Illuminate\Support\Facades\Route;
use App\Http\Controllers\Api\V1\{
  AuthController,
  AuthSpaController,
  AuthTokenController,
  RegisterController,
  SessionController,
  TokenController,
  SocialAuthController
};

Route::prefix('v1')->group(function(){
  // Public — no auth
  Route::middleware('guest:sanctum')->group(function(){

    // Login — strictest limiter (brute force target)
    Route::post('/login', [AuthSpaController::class, 'login'])
      ->middleware('throttle:login');

    Route::post('/login/mobile', [AuthTokenController::class, 'login'])
      ->middleware('throttle:login');

    // Register
    Route::post('/register', RegisterController::class)
      ->middleware('throttle:register');

    // Password reset — sensitive
    Route::post('/forgot-password', [AuthController::class, 'forgotPassword'])
      ->middleware('throttle:sensitive');

    Route::post('/reset-password', [AuthController::class, 'resetPassword'])
      ->middleware('throttle:sensitive');

    // Social OAuth — moderate
    Route::get('/auth/{provider}/redirect', [SocialAuthController::class, 'redirect'])
      ->middleware('throttle:oauth');

    Route::post('/auth/{provider}/mobile', [SocialAuthController::class, 'mobileCallback'])
      ->middleware(['throttle:login', 'throttle:oauth']);
  });

  // Protected reads — higher limit
  Route::middleware(['auth:sanctum', 'throttle:api'])->group(function(){
    Route::get('/me', [AuthController::class, 'me']);
    Route::get('/me/email/verify/{token}', [AuthController::class, 'verifyPendingEmail']);
    Route::get('/sessions', [SessionController::class, 'index']);
    Route::get('/tokens', [TokenController::class, 'index']);
    Route::get('/auth/providers', [SocialAuthController::class, 'linkedProviders']);
  });

  // Protected mutations — stricter limit
  Route::middleware(['auth:sanctum', 'throttle:mutations'])->group(function(){
    // Profile
    Route::put('/me', [AuthController::class, 'updateUser']);
    Route::put('/me/change-password', [AuthController::class, 'changePassword']);
    Route::post('/me/password', [AuthController::class, 'setPassword']);
    Route::delete('/me/email/pending', [AuthController::class, 'cancelPendingEmail']);

    // Avatar — extra upload limiter on top of mutations
    Route::post('/me/avatar', [AuthController::class, 'updateAvatar'])
      ->middleware('throttle:upload');
    Route::delete('/me/avatar', [AuthController::class, 'deleteAvatar']);

    // Email
    Route::post('/email/resend', [AuthController::class, 'resendVerification'])
      ->middleware('throttle:sensitive');

    // Logout
    Route::post('/logout', [AuthSpaController::class, 'logout']);
    Route::post('/logout/all', [AuthSpaController::class, 'logoutAll']);
    Route::post('/logout/mobile', [AuthTokenController::class, 'logout']);

    // Sessions
    Route::delete('/sessions/current', [SessionController::class, 'destroyCurrent']);
    Route::delete('/sessions/others', [SessionController::class, 'destroyOthers']);
    Route::delete('/sessions/all', [SessionController::class, 'destroyAll']);
    Route::delete('/sessions/{sessionId}', [SessionController::class, 'destroy']);

    // Tokens
    Route::delete('/tokens/current', [TokenController::class, 'destroyCurrent']);
    Route::delete('/tokens/all', [TokenController::class, 'destroyAll']);
    Route::delete('/tokens/{tokenId}', [TokenController::class, 'destroy']);

    // Social
    Route::post('/auth/{provider}/link', [SocialAuthController::class, 'link'])
      ->middleware('throttle:oauth');
    Route::delete('/auth/providers/{provider}', [SocialAuthController::class, 'unlink']);
  });
});