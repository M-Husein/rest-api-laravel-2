<?php
// use Illuminate\Http\Request;
use Illuminate\Support\Facades\Route;
use App\Http\Controllers\Api\V1\{
  AuthController,
  RegisterController,
  TranslationController,
  PageTranslationController,
  SocialiteController
};

Route::prefix('v1')->group(function(){
  Route::middleware('guest')->group(function(){
    // Public auth endpoints
    Route::post('/login', [AuthController::class, 'login']);
    Route::post('/register', RegisterController::class);
    Route::post('/forgot-password', [AuthController::class, 'forgotPassword']);
    Route::post('/reset-password', [AuthController::class, 'resetPassword']);

    // Public OAuth endpoints
    Route::get('/auth/{provider}/redirect', [SocialiteController::class, 'redirect']);
    Route::get('/auth/{provider}/callback', [SocialiteController::class, 'callback']);
  });

  Route::get('/locales/{lang}/common', [TranslationController::class, 'getCommon']);

  // Public endpoint for frontend to fetch page translations
  Route::get('/locales/{lang}/page/{name}', [PageTranslationController::class, 'getByPageLang']);

  // Refresh token
  Route::post('/refresh', [AuthController::class, 'refresh']);

  // Protected by auth + permissions later
  Route::middleware('auth:sanctum')->group(function(){
    Route::get('/me', [AuthController::class, 'me']);
    Route::post('/logout', [AuthController::class, 'logout']);
    Route::post('/set-password', [AuthController::class, 'setPassword']);
    Route::post('/auth/{provider}/link', [SocialiteController::class, 'link']);
    Route::delete('/auth/{provider}/unlink', [SocialiteController::class, 'unlink']);
    
    // Email verification (requires authenticated user)
    Route::post('/email/verification-notification', [AuthController::class, 'sendVerificationNotif']);
    Route::get('/email/verify/{id}/{hash}', [AuthController::class, 'verify'])->name('verification.verify');
    Route::get('/email/check', [AuthController::class, 'checkVerificationStatus']);

    // Admin only
    Route::apiResource('page-translations', PageTranslationController::class);
  });
});